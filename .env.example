PORT=3000
NODE_ENV=development

# Razorpay Test API Keys (Optional - System uses Mock Mode if missing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Demo Configuration
# In demo mode, retry delay is set in minutes instead of hours
DEMO_RETRY_INTERVAL_MINUTES=2
MAX_RETRIES=3
